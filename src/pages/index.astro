---
import '../styles/global.css';
import { profile } from '../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => path.startsWith('/') ? `${base}${path}` : path;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const nav = [
  { href: '#about', label: '关于我' },
  { href: '#research', label: '研究方向' },
  { href: '#publications', label: '论文与项目' },
  { href: '#experience', label: '经历' },
  { href: '#contact', label: '联系方式' }
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={profile.bio} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={`${profile.displayName} · ${profile.title}`} />
    <meta property="og:description" content={profile.bio} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <title>{profile.displayName} · {profile.title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">跳转到正文</a>
    <header class="masthead">
      <div class="masthead-inner">
        <a class="site-title" href="#top">{profile.displayName}</a>
        <nav class="top-nav" aria-label="主导航">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <details class="mobile-nav">
          <summary aria-label="栏目导航">栏目 <span aria-hidden="true">☰</span></summary>
          <nav aria-label="移动端导航">{nav.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
        </details>
      </div>
    </header>

    <main id="main" class="page-shell">
      <aside class="sidebar" aria-label="个人信息">
        <div class="profile-card">
          {profile.avatar ? (
            <img class="avatar" src={asset(profile.avatar)} alt={`${profile.displayName}的头像`} />
          ) : (
            <div class="avatar avatar-placeholder" aria-hidden="true">{profile.initials}</div>
          )}
          <h1>{profile.displayName}</h1>
          <p class="sidebar-title">{profile.title}</p>
          <p class="sidebar-bio">{profile.bio}</p>
          <ul class="contact-list">
            {profile.location && <li><span class="icon">⌖</span>{profile.location}</li>}
            {profile.affiliation && <li><span class="icon">▣</span>{profile.affiliation}</li>}
            {profile.email && <li><span class="icon">✉</span><a href={`mailto:${profile.email}`}>{profile.email}</a></li>}
          </ul>
          <div class="sidebar-links">
            {profile.github && <a href={profile.github} rel="noreferrer">GitHub <span>↗</span></a>}
            {profile.scholar && <a href={profile.scholar} rel="noreferrer">Google Scholar <span>↗</span></a>}
            {profile.orcid && <a href={profile.orcid} rel="noreferrer">ORCID <span>↗</span></a>}
            {profile.linkedin && <a href={profile.linkedin} rel="noreferrer">LinkedIn <span>↗</span></a>}
            {profile.cv && <a href={asset(profile.cv)}>简历 / CV <span>↗</span></a>}
          </div>
        </div>
      </aside>

      <div class="content-column">
        <section id="about" class="content-section intro-section" aria-labelledby="about-title">
          <p class="kicker">欢迎来到我的个人主页</p>
          <h2 id="about-title">关于我</h2>
          {profile.about.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <section id="research" class="content-section" aria-labelledby="research-title">
          <div class="section-heading"><span class="section-index">01</span><h2 id="research-title">研究方向</h2></div>
          <div class="research-grid">
            {profile.research.map((item) => (
              <article class="research-item">
                <h3>{item.title}</h3>
                <p class="research-subtitle" lang="en">{item.subtitle}</p>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="publications" class="content-section" aria-labelledby="publications-title">
          <div class="section-heading"><span class="section-index">02</span><h2 id="publications-title">论文与项目</h2></div>
          <div class="publication-list">
            {profile.publications.length === 0 && <p class="empty-state">相关论文与项目将在这里更新。</p>}
            {profile.publications.map((item) => (
              <article class="publication-item">
                <div class="publication-year">{item.year}</div>
                <div>
                  <h3>{item.title}</h3>
                  <p class="authors">{item.authors}</p>
                  <p class="venue">{item.venue}</p>
                  <p class="description">{item.description}</p>
                  <div class="resource-links">
                    {item.pdf && <a href={asset(item.pdf)}>PDF ↗</a>}
                    {item.code && <a href={item.code} rel="noreferrer">Code ↗</a>}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="experience" class="content-section" aria-labelledby="experience-title">
          <div class="section-heading"><span class="section-index">03</span><h2 id="experience-title">经历</h2></div>
          {profile.experience.length > 0 && <div class="timeline">
            {profile.experience.map((item) => (
              <article class="timeline-item">
                <div class="timeline-period">{item.period}</div>
                <div><h3>{item.role}</h3><p class="organization">{item.organization}</p><p>{item.description}</p></div>
              </article>
            ))}
          </div>}
          <div class="education">
            <h3 class="subheading">教育背景</h3>
            {profile.education.map((item) => <div class="education-row">{item.period && <span>{item.period}</span>}{item.degree && <strong>{item.degree}</strong>}<em>{item.organization}</em></div>)}
          </div>
        </section>

        {profile.news.length > 0 && <section class="content-section news-section" aria-labelledby="news-title">
          <div class="section-heading"><span class="section-index">04</span><h2 id="news-title">最新动态</h2></div>
          <ul class="news-list">
            {profile.news.map((item) => <li><time>{item.date}</time><span>{item.text}</span></li>)}
          </ul>
        </section>}

        <section id="contact" class="content-section contact-section" aria-labelledby="contact-title">
          <h2 id="contact-title">联系我</h2>
          <p>欢迎交流研究、项目与合作想法。</p>
          {profile.email ? <a class="email-link" href={`mailto:${profile.email}`}>{profile.email} ↗</a> : profile.github ? <a class="email-link" href={profile.github}>通过 GitHub 联系 ↗</a> : <p class="muted-note">联系方式待补充。</p>}
        </section>

        <footer class="site-footer"><span>© {new Date().getFullYear()} {profile.displayName}</span><span>Built with Astro · Inspired by <a href="https://academicpages.github.io/">Academic Pages</a></span></footer>
      </div>
    </main>
  </body>
</html>
